{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "8280724326121620466"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for resources that support regional deployment."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "aks-upgrade-agent",
      "metadata": {
        "description": "Prefix used for generated names in later phases."
      }
    },
    "existingAksClusterResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of the existing AKS cluster to operate against."
      }
    },
    "aksMcpIdentityName": {
      "type": "string",
      "defaultValue": "[format('{0}-mcp-mi', parameters('namePrefix'))]",
      "metadata": {
        "description": "User-assigned managed identity name for AKS MCP service."
      }
    },
    "assignAksRoles": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Assign Azure RBAC roles on the target AKS resource when true."
      }
    },
    "aksRoleDefinitionGuids": {
      "type": "array",
      "defaultValue": [
        "acdd72a7-3385-48ef-bd42-f606fba81ae7",
        "4abbcc35-e782-43d8-92c5-2d3f1bd2253f"
      ],
      "metadata": {
        "description": "Role definition GUIDs to assign at AKS scope. Defaults: Reader, Azure Kubernetes Service Cluster User Role."
      }
    },
    "deployAksMcpFunction": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy Azure Functions hosting resources for the AKS MCP service."
      }
    },
    "aksMcpFunctionStorageAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional explicit storage account name for the AKS MCP Function App."
      }
    },
    "aksMcpFunctionPlanName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional explicit App Service plan name for the AKS MCP Function App."
      }
    },
    "aksMcpFunctionAppName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional explicit Function App name for the AKS MCP service."
      }
    },
    "aksMcpLogAnalyticsWorkspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional explicit Log Analytics workspace name used by the AKS MCP service monitoring stack."
      }
    },
    "aksMcpApplicationInsightsName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional explicit Application Insights name for the AKS MCP service monitoring stack."
      }
    }
  },
  "variables": {
    "aksIdParts": "[split(parameters('existingAksClusterResourceId'), '/')]",
    "aksSubscriptionId": "[if(not(empty(parameters('existingAksClusterResourceId'))), variables('aksIdParts')[2], '')]",
    "aksResourceGroup": "[if(not(empty(parameters('existingAksClusterResourceId'))), variables('aksIdParts')[4], '')]",
    "aksClusterName": "[if(not(empty(parameters('existingAksClusterResourceId'))), variables('aksIdParts')[8], '')]",
    "functionStorageAccountName": "[if(not(empty(parameters('aksMcpFunctionStorageAccountName'))), toLower(parameters('aksMcpFunctionStorageAccountName')), take(format('aksmcp{0}', uniqueString(subscription().id, resourceGroup().id, parameters('namePrefix'))), 24))]",
    "functionPlanName": "[if(not(empty(parameters('aksMcpFunctionPlanName'))), parameters('aksMcpFunctionPlanName'), take(format('{0}-mcp-fn-plan-{1}', parameters('namePrefix'), uniqueString(resourceGroup().id)), 40))]",
    "functionAppName": "[if(not(empty(parameters('aksMcpFunctionAppName'))), parameters('aksMcpFunctionAppName'), take(format('{0}-mcp-fn-{1}', parameters('namePrefix'), uniqueString(resourceGroup().id)), 60))]",
    "logAnalyticsWorkspaceName": "[if(not(empty(parameters('aksMcpLogAnalyticsWorkspaceName'))), parameters('aksMcpLogAnalyticsWorkspaceName'), take(format('{0}-mcp-law-{1}', parameters('namePrefix'), uniqueString(resourceGroup().id)), 63))]",
    "applicationInsightsName": "[if(not(empty(parameters('aksMcpApplicationInsightsName'))), parameters('aksMcpApplicationInsightsName'), take(format('{0}-mcp-ai-{1}', parameters('namePrefix'), uniqueString(resourceGroup().id)), 260))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('aksMcpIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "condition": "[parameters('deployAksMcpFunction')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('functionStorageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "condition": "[parameters('deployAksMcpFunction')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "condition": "[parameters('deployAksMcpFunction')]",
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('applicationInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "condition": "[parameters('deployAksMcpFunction')]",
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('functionPlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "condition": "[parameters('deployAksMcpFunction')]",
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName')))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('functionPlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "Python|3.11",
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "python"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', variables('functionStorageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('functionStorageAccountName')), '2023-05-01').keys[0].value, environment().suffixes.storage)]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('applicationInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('applicationInsightsName')), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "AKS_MCP_HOST",
              "value": "0.0.0.0"
            },
            {
              "name": "AKS_MCP_PORT",
              "value": "8000"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('applicationInsightsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('functionPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('functionStorageAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName'))]"
      ]
    },
    {
      "condition": "[and(not(empty(parameters('existingAksClusterResourceId'))), parameters('assignAksRoles'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('aks-role-assignment-{0}', uniqueString(parameters('existingAksClusterResourceId'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName'))))]",
      "subscriptionId": "[variables('aksSubscriptionId')]",
      "resourceGroup": "[variables('aksResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "aksClusterName": {
            "value": "[variables('aksClusterName')]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName')), '2023-01-31').principalId]"
          },
          "roleDefinitionGuids": {
            "value": "[parameters('aksRoleDefinitionGuids')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "13408517780203361231"
            }
          },
          "parameters": {
            "aksClusterName": {
              "type": "string",
              "metadata": {
                "description": "Name of the existing AKS cluster in this resource group."
              }
            },
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID of the identity receiving permissions."
              }
            },
            "roleDefinitionGuids": {
              "type": "array",
              "metadata": {
                "description": "Role definition GUIDs to assign at AKS scope."
              }
            }
          },
          "resources": [
            {
              "copy": {
                "name": "aksRoleAssignments",
                "count": "[length(parameters('roleDefinitionGuids'))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('aksClusterName'))]",
              "name": "[guid(resourceId('Microsoft.ContainerService/managedClusters', parameters('aksClusterName')), parameters('principalId'), parameters('roleDefinitionGuids')[copyIndex()])]",
              "properties": {
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionGuids')[copyIndex()])]"
              }
            }
          ],
          "outputs": {
            "assignedRoleDefinitionGuids": {
              "type": "array",
              "value": "[parameters('roleDefinitionGuids')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName'))]"
      ]
    }
  ],
  "outputs": {
    "deploymentLocation": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "deploymentNamePrefix": {
      "type": "string",
      "value": "[parameters('namePrefix')]"
    },
    "targetAksClusterResourceId": {
      "type": "string",
      "value": "[parameters('existingAksClusterResourceId')]"
    },
    "aksMcpIdentityNameOut": {
      "type": "string",
      "value": "[parameters('aksMcpIdentityName')]"
    },
    "aksMcpIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName')), '2023-01-31').principalId]"
    },
    "aksMcpIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName')), '2023-01-31').clientId]"
    },
    "assignedAksRoleDefinitionGuids": {
      "type": "array",
      "value": "[if(parameters('assignAksRoles'), parameters('aksRoleDefinitionGuids'), createArray())]"
    },
    "aksMcpFunctionAppNameOut": {
      "type": "string",
      "value": "[if(parameters('deployAksMcpFunction'), variables('functionAppName'), '')]"
    },
    "aksMcpFunctionAppHostName": {
      "type": "string",
      "value": "[if(parameters('deployAksMcpFunction'), reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2023-12-01').defaultHostName, '')]"
    },
    "aksMcpFunctionAppEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployAksMcpFunction'), format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2023-12-01').defaultHostName), '')]"
    },
    "AKS_MCP_FUNCTION_APP_NAME": {
      "type": "string",
      "value": "[if(parameters('deployAksMcpFunction'), variables('functionAppName'), '')]"
    },
    "AKS_MCP_FUNCTION_APP_ENDPOINT": {
      "type": "string",
      "value": "[if(parameters('deployAksMcpFunction'), format('https://{0}/api/mcp', reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2023-12-01').defaultHostName), '')]"
    },
    "AKS_MCP_IDENTITY_PRINCIPAL_ID": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('aksMcpIdentityName')), '2023-01-31').principalId]"
    }
  }
}